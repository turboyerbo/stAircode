# ── Required ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# ── Set in Vercel dashboard — do NOT commit ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://staircode.app

# ── Supabase (required for real OTP email/SMS auth) ──────────────────────────
# Create a free project at supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe (required for $6.99 report + $19/mo Pro payments) ─────────────────
# Get keys at dashboard.stripe.com → Developers → API keys
# Use sk_test_... during development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# Create these prices in Stripe dashboard → Products
STRIPE_REPORT_PRICE_ID=price_REPLACE_WITH_REPORT_PRICE_ID
STRIPE_PRO_PRICE_ID=price_REPLACE_WITH_PRO_PRICE_ID

# Get from Stripe dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ── Resend (optional — for emailing the report after purchase) ────────────────
# Free at resend.com — 3,000 emails/month on free tier
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=info@staircode.app

# ── PostHog (analytics + session recordings) ──────────────────────────────────
# Sign up free at posthog.com → New project → copy API key
# Free tier: 1M events/month + unlimited session recordings
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Tally (beta feedback form) ────────────────────────────────────────────────
# Sign up free at tally.so → New form → publish → copy form ID from URL
# e.g. tally.so/r/XXXXXX  →  set NEXT_PUBLIC_TALLY_FORM_ID=XXXXXX
NEXT_PUBLIC_TALLY_FORM_ID=REPLACE_WITH_YOUR_FORM_ID

# ── Survey link (shown in report emails) ─────────────────────────────────────
NEXT_PUBLIC_SURVEY_URL=https://tally.so/r/REPLACE_WITH_YOUR_FORM_ID
